{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opendataproducts.org/odpc-v1.0/schema/odpc.yaml",
  "title": "ODPC 1.0 Catalog Schema",
  "description": "Schema for Open Data Product Catalogs (ODPC) catalog files.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "kind",
    "catalog"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "format": "uri",
      "const": "https://opendataproducts.org/odpc-v1.0/schema/odpc.yaml",
      "description": "URI of the ODPC schema used to validate the catalog file."
    },
    "version": {
      "type": "string",
      "pattern": "^1\\.0$",
      "description": "ODPC specification version used by the catalog file."
    },
    "kind": {
      "type": "string",
      "const": "Catalog",
      "description": "ODPC root object type. Catalog files MUST use Catalog."
    },
    "catalog": {
      "$ref": "#/$defs/Catalog"
    }
  },
  "$defs": {
    "LanguageString": {
      "type": "object",
      "description": "Language-tagged human-readable text. English is required; other BCP 47-like language keys may be added.",
      "required": [
        "en"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        }
      },
      "patternProperties": {
        "^[a-z]{2}(-[A-Z]{2})?$": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "ExtensionProperties": {
      "patternProperties": {
        "^x-": {
          "description": "Implementation-specific extension property."
        }
      }
    },
    "LifecycleStatus": {
      "type": "string",
      "description": "Catalog lifecycle status for reusable ODPG-aligned nodes.",
      "enum": [
        "draft",
        "active",
        "deprecated",
        "retired"
      ]
    },
    "WorkItemStatus": {
      "type": "string",
      "description": "Lifecycle status for use cases and business objectives.",
      "enum": [
        "draft",
        "active",
        "paused",
        "completed",
        "retired"
      ]
    },
    "Priority": {
      "type": "string",
      "description": "Relative portfolio importance.",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "TagList": {
      "type": "array",
      "description": "Keywords used for search, grouping, and filtering.",
      "items": {
        "type": "string"
      }
    },
    "Reference": {
      "type": "string",
      "minLength": 1,
      "description": "Local path or URI that resolves to an authoritative external definition."
    },
    "UriReference": {
      "type": "string",
      "format": "uri",
      "minLength": 1,
      "description": "URI that resolves to an authoritative external definition."
    },
    "Date": {
      "type": "string",
      "format": "date"
    },
    "Domain": {
      "type": "object",
      "description": "Reusable ODPC domain object aligned with an ODPG Domain node.",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "name",
        "description"
      ],
      "properties": {
        "kind": {
          "const": "domain"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "$ref": "#/$defs/LanguageString"
        },
        "description": {
          "$ref": "#/$defs/LanguageString"
        },
        "type": {
          "type": "string",
          "enum": [
            "business",
            "organizational",
            "data",
            "technical"
          ]
        },
        "owner": {
          "$ref": "#/$defs/Owner"
        },
        "status": {
          "$ref": "#/$defs/LifecycleStatus"
        },
        "$ref": {
          "$ref": "#/$defs/Reference"
        },
        "tags": {
          "$ref": "#/$defs/TagList"
        }
      },
      "patternProperties": {
        "^x-": {}
      }
    },
    "Dataset": {
      "type": "object",
      "description": "Reusable ODPC dataset object aligned with an ODPG Dataset node.",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "name",
        "description"
      ],
      "properties": {
        "kind": {
          "const": "dataset"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "$ref": "#/$defs/LanguageString"
        },
        "description": {
          "$ref": "#/$defs/LanguageString"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "frequency": {
          "type": "string",
          "enum": [
            "realTime",
            "hourly",
            "daily",
            "weekly",
            "monthly",
            "quarterly",
            "annual",
            "irregular",
            "static"
          ]
        },
        "classification": {
          "type": "string",
          "enum": [
            "public",
            "internal",
            "confidential",
            "restricted"
          ]
        },
        "access": {
          "type": "string",
          "enum": [
            "open",
            "authenticated",
            "restricted"
          ]
        },
        "owner": {
          "$ref": "#/$defs/Owner"
        },
        "status": {
          "$ref": "#/$defs/LifecycleStatus"
        },
        "$ref": {
          "$ref": "#/$defs/Reference"
        },
        "tags": {
          "$ref": "#/$defs/TagList"
        }
      },
      "patternProperties": {
        "^x-": {}
      }
    },
    "API": {
      "type": "object",
      "description": "Reusable ODPC API object aligned with an ODPG API node.",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "name",
