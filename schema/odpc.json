            "grpc",
            "event",
            "other"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "endpoint": {
          "type": "string",
          "format": "uri"
        },
        "access": {
          "type": "string",
          "enum": [
            "open",
            "authenticated",
            "restricted"
          ]
        },
        "owner": {
          "$ref": "#/$defs/Owner"
        },
        "status": {
          "$ref": "#/$defs/LifecycleStatus"
        },
        "$ref": {
          "$ref": "#/$defs/Reference"
        },
        "tags": {
          "$ref": "#/$defs/TagList"
        }
      },
      "patternProperties": {
        "^x-": {}
      }
    },
    "Policy": {
      "type": "object",
